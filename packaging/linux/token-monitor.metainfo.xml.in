  </description>
  <categories>
    <category>Development</category>
  </categories>
  <content_rating type="oars-1.1" />
  <url type="homepage">https://github.com/IGNGserver/token-monitor-suite</url>
  <url type="bugtracker">https://github.com/IGNGserver/token-monitor-suite/issues</url>
  <launchable type="desktop-id">token-monitor.desktop</launchable>
  <icon type="stock">token-monitor</icon>
  <provides>
    <binary>token-monitor</binary>
  </provides>
  <releases>
    <release version="__VERSION__" date="__RELEASE_DATE__" />
  </releases>
</component>
